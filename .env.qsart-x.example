# Generate a random URL-safe value before starting the QSART-X Compose stack.
QSART_POSTGRES_PASSWORD=
QSART_WEB_PORT=18700
QSART_WORKSPACE_PORT=18701
QSART_API_PORT=18000
QSART_DASHBOARD_PORT=18501

# Use these paths when the genuine DeepDRiD artifacts are present locally.
QSART_CONTAINER_DR_CHECKPOINT=/checkpoints/development_v1/selected/dr.pt
QSART_CONTAINER_QUALITY_CHECKPOINT=/checkpoints/development_v1/selected/quality.pt
QSART_CONTAINER_CALIBRATION=/checkpoints/development_v1/selected/calibration.json
QSART_CONTAINER_MODEL_CARD=/checkpoints/development_v1/selected/model_card.json
QSART_CONTAINER_CONFORMAL=/checkpoints/spec_v1/conformal_r1.json
QSART_CONTAINER_SIMULATION_DATA=/checkpoints/spec_v1/development_scores.json
