QSART_DR_CHECKPOINT=checkpoints/dr/best.pt
QSART_QUALITY_CHECKPOINT=checkpoints/quality/best.pt
QSART_CALIBRATION=checkpoints/calibration.json
QSART_CPU_THREADS=2
QSART_CONFORMAL=
QSART_SIMULATION_DATA=checkpoints/spec_v1/development_scores.json
QSART_CONTAINER_CONFORMAL=
QSART_CONTAINER_SIMULATION_DATA=/checkpoints/spec_v1/development_scores.json
# After fitting the independent sidecar for the matching selected models, set
# QSART_CONFORMAL=checkpoints/spec_v1/conformal_r1.json (local Python) or
# QSART_CONTAINER_CONFORMAL=/checkpoints/spec_v1/conformal_r1.json (Compose).
QSART_API_URL=http://127.0.0.1:8000
QSART_REPORTS_DIR=reports
QSART_API_PORT=8000
QSART_DASHBOARD_PORT=8501
# Optional container artifact selection. Keep values within the mounted /checkpoints directory.
QSART_CONTAINER_DR_CHECKPOINT=/checkpoints/dr/best.pt
QSART_CONTAINER_QUALITY_CHECKPOINT=/checkpoints/quality/best.pt
QSART_CONTAINER_CALIBRATION=/checkpoints/calibration.json
QSART_CONTAINER_MODEL_CARD=/checkpoints/model_card.json
